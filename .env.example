# WalletConnect Project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Ethereum RPC URLs
NEXT_PUBLIC_ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Contract Addresses (will be populated after deployment)
NEXT_PUBLIC_ORGANISM_FACTORY_ADDRESS=
NEXT_PUBLIC_ECOSYSTEM_ADDRESS=

# IPFS Configuration
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/
IPFS_PROJECT_ID=
IPFS_PROJECT_SECRET=

# The Graph API
NEXT_PUBLIC_GRAPH_API_URL=

# Private key for deployment (NEVER commit this!)
PRIVATE_KEY=
